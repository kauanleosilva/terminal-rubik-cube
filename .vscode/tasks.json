{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar e Rodar (Janela Externa)",
            "type": "shell",
            "command": "mingw32-make all && start cmd /c \"bin\\rubiks_cube.exe & pause\"",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Usa o CMD para compilar via Makefile e abrir o executável em uma nova janela."
        },
        {
            "label": "clearExe",
            "type": "shell",
            "command": "mingw32-make clean",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": []
        }
    ]
}
